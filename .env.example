# ═══════════════════════════════════════════════════════════════════
# 환경변수 예시 — 실제 값은 각자의 .env에만 작성 (.env는 .gitignore됨)
# 복사 후: cp .env.example .env
#
# ┌─ 무엇을 .env에 넣나요? (#152) ─────────────────────────────────────
# │  .env = 배포 환경마다 달라지는 것 (비밀값·엔드포인트·한도·스위치)
# │  코드 = 환경과 무관한 불변 정책 → app/policies.py
# │         (비밀번호 규칙, 보안 헤더·CSP, 로그 마스킹 필드, 문서 경로 등)
# │  판단 기준: "환경을 옮기면 바뀌는가?" 예 → .env / 아니오 → 코드 상수
# └────────────────────────────────────────────────────────────────────
#
# 표기: [필수] 운영에서 설정하지 않으면 시작 거부 또는 안전하지 않음
#       [운영] 운영 배포에서만 의미 있음 (CD가 동기화)
#       [선택] 미설정 시 코드 기본값(app/config.py)으로 동작
# ═══════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────
# ① 보안 비밀값 — [필수] 운영에서 반드시 설정
# ───────────────────────────────────────────────────────────────────

# 세션 쿠키 서명 키 [필수] — 운영(DEBUG=false)에서 공개 기본값·32자 미만이면
# 앱이 시작을 거부한다. 개발(DEBUG=true)이면 임시 키로 자동 대체(재시작 시 세션 초기화).
# 생성: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-random-string

# 비밀번호 페퍼 [필수] — 모든 비밀번호에 HMAC으로 먼저 적용하는 서버 비밀값.
# DB 해시 유출 시에도 페퍼를 모르면 오프라인 대조 불가. 운영에서 미설정/약하면 시작 거부.
# 생성: python -c "import secrets; print(secrets.token_hex(32))"
# ⚠️ 변경 시 기존 비밀번호로 로그인할 수 없게 되니 최초 설정 후에는 바꾸지 않는다.
PASSWORD_PEPPER=

# 운영에서 반드시 false. true면 약한 시크릿 대체·http 쿠키가 허용된다(개발 전용).
# CD는 DEBUG=false를 명시적으로 동기화한다. [운영]
DEBUG=true

# ───────────────────────────────────────────────────────────────────
# ② 기능 활성화 — 실제 값이 필요한 외부 연동
# ───────────────────────────────────────────────────────────────────

# 실 AI 사용 시 필요 [필수-기능]. 없으면 앱은 시작하지만 데모 모드(가짜 응답)로 동작하며
# 데모 응답은 "AI 연결 성공 증거"가 아니다. 운영 URL 게시 전 반드시 설정.
AI_API_KEY=

# ── 코디세이 '네이토' (OpenAI 호환) 사용 예 ──────────────────
# 아래 3줄만 바꾸면 코드 수정 없이 연결됩니다.
# 실제 엔드포인트/모델명은 코디세이 콘솔의 API 문서에서 확인:
#   AI_BASE_URL=https://(코디세이-호스트)/v1        ← /v1까지만 적어도 됨(/chat/completions 자동 추가)
#   AI_MODEL=(네이토 모델명)
#   AI_API_KEY=(코디세이 발급 키)
# 연결 확인: python scripts/ai_check.py
# ───────────────────────────────────────────────────────────────────

# ───────────────────────────────────────────────────────────────────
# ③ 환경별 값 — 배포 대상에 따라 달라진다
# ───────────────────────────────────────────────────────────────────

# DB [환경별] — 기본은 SQLite. PostgreSQL/MySQL로도 전환 가능(스키마는 Alembic으로 마이그레이션).
#   SQLite 파일 (기본·개발): sqlite:///./app.db
#   SQLite 인메모리(테스트): sqlite://
#   PostgreSQL:            postgresql+psycopg2://user:pass@host:5432/dbname
#   MySQL/MariaDB:         mysql+pymysql://user:pass@host:3306/dbname  (pymysql 별도 설치 필요)
DATABASE_URL=sqlite:///./app.db
# Railway 배포 시 SQLite 유지: sqlite:////data/app.db (Volume /data 마운트 — docs/RAILWAY_DEPLOY.md)
# PostgreSQL로 전환: Railway Postgres 애드온의 DATABASE_URL을 그대로 복사해 넣고
#   `alembic upgrade head`로 스키마를 생성 (docs/POSTGRES_MIGRATION.md 참고).

# /docs·/redoc·/openapi.json 노출 [운영] — 로컬/검증 true, 운영 CD는 false 동기화(#75)
DOCS_ENABLED=true

# ───────────────────────────────────────────────────────────────────
# ④ 선택 오버라이드 — [선택] 미설정 시 코드 기본값(app/config.py)으로 동작.
#     운영에서 기본값을 쓰고 싶으면 굳이 .env에 적지 않는다 (적힌 값이 문서가 된다).
# ───────────────────────────────────────────────────────────────────

# AI 엔드포인트/모델 (OpenAI 호환 — 실제 제공사: 코디세이 네이토. OpenAI/Groq 등도 호환)
# 네이토 사용 시 아래 두 값을 네이토 문서 값으로 변경.
AI_BASE_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# AI 전체 호출 시간 예산(초): 연결·읽기·추가 시도·대기 포함, DB 시간 제외
AI_TIMEOUT_SEC=45
AI_MAX_RETRIES=1
# 응답 생성 토큰 상한·온도 — 미설정 시 제공사 기본값(길이 무제한·온도 1.0)에 노출되는 것을 방지
AI_MAX_TOKENS=800
AI_TEMPERATURE=0.6

# 로그인 무차별 대입 방어(#72) — 이메일별 실패 N회 누적 시 잠금(초). 프로세스 메모리·단일 워커 전제
LOGIN_MAX_FAILS=5
LOGIN_LOCKOUT_SEC=900

# 채팅 비용 남용 방어(#73) — 사용자별 분당 요청 상한. 초과 시 429. 0=비활성화
CHAT_RATE_PER_MIN=10

# 컨텍스트: 직전 성공 Q/A 쌍. 0=비활성화, 최대 200
CONTEXT_TURNS=5

# 질문 최대 Unicode 코드 포인트 수. 프론트에도 같은 상한을 전달
MAX_QUESTION_LENGTH=1000

# 세션 쿠키 수명(시간) — 기본 24, 상한 168(7일). 계정별 폐기: scripts/revoke_sessions.py
SESSION_MAX_AGE_HOURS=24

# 비밀번호 재설정 토큰 만료(분)·요청 상한(창 내 N회)
PASSWORD_RESET_EXPIRY_MINUTES=30
PASSWORD_RESET_MAX_REQUESTS=3
PASSWORD_RESET_WINDOW_MINUTES=15

# ───────────────────────────────────────────────────────────────────
# ⑤ 비밀번호 재설정 메일 — 미설정 시: DEBUG=true면 재설정 링크를 서버 로그로만
#     출력(개발), 운영은 재설정 요청이 503으로 안내된다. [선택→운영에서 권장]
# ───────────────────────────────────────────────────────────────────

# 예(Gmail 앱 비밀번호): SMTP_HOST=smtp.gmail.com, SMTP_PORT=465(SSL) 또는 587(STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AI Chatbot Service <no-reply@example.com>

# ── 이메일 발송 — Resend HTTPS API (Railway Free/Hobby 권장) ─────
# Railway Free/Hobby는 아웃바운드 SMTP(25/465/587/2525)를 차단한다(Pro만 허용).
# RESEND_API_KEY가 있으면 SMTP보다 우선 사용. 443 HTTPS라 어디서든 발송된다.
# 도메인 인증 전 기본 발신자(onboarding@resend.dev)는 수신이 Resend 계정 본인 이메일로 제한된다.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
